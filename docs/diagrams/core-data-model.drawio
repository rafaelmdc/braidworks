<mxfile host="app.diagrams.net" agent="threadworks-docs" version="24.0.0">
  <diagram name="Core Data Model" id="core-data-model">
    <mxGraphModel dx="1500" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 2. Core data model and contracts." style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every datum is a typed Token; a TokenSet groups them for one entity. A Weaver declares Capabilities (what it consumes / produces) in a Manifest and returns a WeaveResult. The Planner emits a ResolutionPlan of CapabilityInvocations; the Cache keys results by CacheKey." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&#9670; owns (composition)&#160;&#160;&#160;&#9655; is-a (inheritance)&#160;&#160;&#160;– – &#9655; produces / uses" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="700" y="14" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- cluster containers -->
        <mxCell id="c-data" value="Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;fontColor=#999999;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="190" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c-contracts" value="Contracts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;fontColor=#999999;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="86" width="220" height="610" as="geometry" />
        </mxCell>
        <mxCell id="c-results" value="Results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;fontColor=#999999;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="86" width="210" height="370" as="geometry" />
        </mxCell>
        <mxCell id="c-plan" value="Plan &amp; Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;fontColor=#999999;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="86" width="200" height="570" as="geometry" />
        </mxCell>

        <!-- DATA -->
        <mxCell id="token" value="&lt;b&gt;Token&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;type_id&lt;br&gt;value&lt;br&gt;confidence&lt;br&gt;provenance&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="150" height="108" as="geometry" />
        </mxCell>
        <mxCell id="tokenset" value="&lt;b&gt;TokenSet&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;entity_id&lt;br&gt;tokens&lt;br&gt;requires_review&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="276" width="150" height="96" as="geometry" />
        </mxCell>

        <!-- CONTRACTS -->
        <mxCell id="manifest" value="&lt;b&gt;WeaverManifest&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;weaver_id&lt;br&gt;version&lt;br&gt;capabilities&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="118" width="160" height="96" as="geometry" />
        </mxCell>
        <mxCell id="capability" value="&lt;b&gt;Capability&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;&quot;&gt;id&lt;br&gt;consumes&lt;br&gt;produces&lt;br&gt;backends&lt;br&gt;cost&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="262" width="160" height="124" as="geometry" />
